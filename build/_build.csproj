<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <Deterministic>False</Deterministic>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <NukeRootDirectory>..</NukeRootDirectory>
    <NukeScriptDirectory>..</NukeScriptDirectory>
    <!-- NUKE CONFIGURATION -->
    <NukeVersion>7.0.6</NukeVersion>
    <AssemblyVersion>9.0.0</AssemblyVersion>
    <FileVersion>9.0.0</FileVersion>
    <InformationalVersion>9.0.0</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2023.3.0" />
    <PackageReference Include="Nuke.Common" Version="$(NukeVersion)" />
    <PackageReference Include="Nuke.CodeGeneration" Version="$(NukeVersion)" />
    <PackageDownload Include="GitVersion.Tool" Version="[5.12.0]" />
    <PackageReference Include="GitVersion.CommandLine" Version="5.12.0" />
    <PackageReference Include="Nuke.WebDocu" Version="3.0.0" />
    <PackageReference Include="Nuke.GitHub" Version="5.0.0" />
  </ItemGroup>
</Project>